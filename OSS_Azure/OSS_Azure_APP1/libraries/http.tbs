include "global.tbh"

'chunked transfer encoding: what is expected next
#define HTTP_CHUNK_SIZE		0	'chunk size line
#define HTTP_CHUNK_DATA		1	'chunk data
#define HTTP_CHUNK_CRLF		2	'CR LF after the chunk data
#define HTTP_CHUNK_TRAILER	3	'trailer lines after the last (zero size) chunk

#define HTTP_MAX_STEPS_PER_EVENT	32

dim http_start_called as boolean=false
dim http_methods(6) as string(7) = {"GET", "HEAD", "POST", "PUT", "DELETE", "PATCH"}
dim http_request_item as http_request_type
dim http_timer_count as word = 0
dim http_chunk_length as dword = 0

dim http_line as string = ""					'response line being received; kept between data events
dim http_status_code as word = 0
dim http_interim_response as boolean = false	'1xx response (e.g. 100 Continue): skip it
dim http_content_length_seen as boolean = false
dim http_body_until_close as boolean = false	'no length and not chunked: body ends when the server closes
dim http_chunk_state as byte = HTTP_CHUNK_SIZE
dim http_buffers_ready as boolean = false

declare function http_proc_step() as boolean

sub http_debugprint(byref print_data as string)
#if HTTP_DEBUG_PRINT
	dim s as string

	s = HTTP_STAMP + left(print_data,HTTP_MAX_DATA_LENGTH) + HTTP_CR_LF
	callback_http_debugprint(s)
	#if HTTP_DEBUG_PRINT = 2
		sys.debugprint(s)
	#endif
#endif
end sub

sub http_start()

	if http_start_called=true then
		exit sub
	else
		http_start_called=true
	end if
	http_request_item.state=FREE
	http_request_item.socket = sock_get("HTT")

end sub

sub http_stop()

	if http_start_called=true then
		http_request_item.state=FREE
		sock_release(http_request_item.socket)
	end if
	http_start_called=false
	'the next http_start() may get another socket
	http_buffers_ready=false

end sub

sub http_clear_response()
'Resets everything learned from a previous response
	http_request_item.remaining_response_content_length=0
	http_request_item.chunked=false
	http_chunk_length=0
	http_line=""
	http_status_code=0
	http_interim_response=false
	http_content_length_seen=false
	http_body_until_close=false
	http_chunk_state=HTTP_CHUNK_SIZE
end sub

sub http_reset_socket()
'Ends the current request without blocking: a closing socket finishes in the background,
'and http_init_request_socket() discards anything left of it before the next connection.
	sock.num=http_request_item.socket
	http_request_item.remaining_response_content_length=0
	http_request_item.state=FREE
	http_request_item.domain_name=""
	http_line=""
	if sock.statesimple=PL_SSTS_EST then
		sock.close()
	else
		sock.discard()
	end if
	sock.txclear()
	sock.rxclear()
	#if TLS_AVAILABLE
		'release the TLS session only if this socket holds it
		if sock.tlscurrentnum=http_request_item.socket then
			sock.tlsdeinit()
		end if
	#endif

end sub

sub http_request_complete()

	if http_request_item.state=FREE then exit sub
	http_reset_socket()
	#if HTTP_DEBUG_PRINT
		http_debugprint("Request complete")
	#endif
	callback_http_request_complete()

end sub

function http_check_socket_list() as ok_ng

	http_check_socket_list=NG
	if http_start_called=true and http_request_item.socket=sock.num and sock.num<>255 then
		http_check_socket_list=ok
	end if

end function

sub http_failed(byref error_message as string)

	'only one failure callback per request
	if http_request_item.state=FREE then exit sub
	http_reset_socket()
	#if HTTP_DEBUG_PRINT
		http_debugprint("Failed reason:" + error_message)
	#endif
	callback_http_request_failed(error_message)

end sub

sub http_send_data(byref data as string)
'Sends data on the HTTP socket. Gives up (and fails the request) if the connection
'is gone or no data could be sent for HTTP_SEND_TIMEOUT ms, instead of waiting forever.
	dim buf as string = data
	dim tmr as dword
	dim n as word
	dim connected as boolean

	if http_request_item.state=FREE then exit sub	'request already failed
	sock.num=http_request_item.socket
	tmr=sys.timercountms

	while len(buf)>0
		connected=false
		if http_request_item.tls=true then
#if TLS_AVAILABLE
			connected=(sock.state=PL_SST_EST_TLS)
#endif
		else
			connected=(sock.statesimple=PL_SSTS_EST)
		end if
		if connected=false then
			http_failed("Connection lost while sending")
			exit sub
		end if

		n=0
		if http_request_item.tls=true then
#if TLS_AVAILABLE
			n=sock.tlssetdata(buf)	'(was: data, which resent the start after a partial write)
#endif
		else
			n=sock.txfree
			if n>len(buf) then n=len(buf)
			if n>0 then sock.setdata(left(buf,n))
		end if

		if n>0 then
			sock.send()
			buf=right(buf,len(buf)-n)
			tmr=sys.timercountms
		else if sys.timercountms-tmr>=HTTP_SEND_TIMEOUT then
			http_failed("Send timeout")
			exit sub
		end if
	wend
	#if HTTP_DEBUG_PRINT
		http_debugprint("SEND>" + data)
	#endif

end sub

function http_get_data(size as byte) as string
	sock.num=http_request_item.socket
	if http_request_item.tls=true then
#if TLS_AVAILABLE
		http_get_data=sock.tlsgetdata(size)
#endif
	else
		http_get_data=sock.getdata(size)
	end if

end function

function http_peek_data(size as byte) as string
	sock.num=http_request_item.socket
	if http_request_item.tls=true then
#if TLS_AVAILABLE
		http_peek_data=sock.tlspeekdata(size)
#endif
	else
		http_peek_data=sock.peekdata(size)
	end if

end function

sub http_to_lower_case(byref input_string as string)

	dim b, c as byte
	dim modified_string as string = ""
	for b=1 to len(input_string)
		c=asc(mid(input_string,b,1))
		if c>64 and c<91 then
			c=c+32
		end if
		modified_string=modified_string+chr(c)
	next b
	input_string=modified_string

end sub

function http_read_line() as boolean
'Collects one response line in http_line. Returns true when the line is complete
'(CR LF removed). A partial line stays in http_line until more data arrives.
	dim chunk as string
	dim p as byte

	http_read_line=false
	do
		chunk=http_peek_data(255)
		if len(chunk)=0 then exit function
		p=instr(1,chunk,"\x0a",1)
		if p=0 then
			http_line=http_line+http_get_data(len(chunk))
		else
			http_line=http_line+http_get_data(p)	'(a line longer than 255 bytes is cut off)
			if right(http_line,1)="\x0a" then http_line=left(http_line,len(http_line)-1)
			if right(http_line,1)="\x0d" then http_line=left(http_line,len(http_line)-1)
			http_read_line=true
			exit function
		end if
	loop while true
end function

sub http_headers_done()
'Called at the empty line that ends the headers: work out how the body ends

	if http_interim_response=true then
		'end of a 1xx response: the real response follows
		http_interim_response=false
		http_request_item.state=REQUEST_SENT
		exit sub
	end if

	http_request_item.state=HTTP_HEADERS_PROCESSED
	http_body_until_close=false
	if http_request_item.method=HTTP_HEAD or http_status_code=204 or http_status_code=304 then
		'no body, whatever Content-Length says
		http_request_item.chunked=false
		http_request_item.remaining_response_content_length=0
	else if http_request_item.chunked=true then
		http_chunk_state=HTTP_CHUNK_SIZE
		http_request_item.remaining_response_content_length=0
	else if http_content_length_seen=false then
		http_body_until_close=true
	end if

	callback_http_headers_complete()
	#if HTTP_DEBUG_PRINT
		http_debugprint("Headers Complete")
	#endif

	if http_request_item.state=HTTP_HEADERS_PROCESSED and http_request_item.chunked=false and http_body_until_close=false and http_request_item.remaining_response_content_length=0 then
		http_request_complete()
	end if

end sub

function http_get_headers() as boolean
'Handles one line of the status line / headers. Returns true if a line was handled.

	dim b as byte
	dim code as string(3)
	dim header_type, header_value, lower_type, lower_value as string

	http_get_headers=false
	if http_read_line()=false then exit function
	http_timer_count=0

	if http_request_item.state=REQUEST_SENT then
		'status line, e.g. "HTTP/1.1 200 OK" (the reason text is optional)
		b=instr(1,http_line," ",1)
		if left(http_line,5)<>"HTTP/" or b=0 then
			http_failed("Invalid response")
			exit function
		end if
		code=mid(http_line,b+1,3)
		http_status_code=val(code)
		if http_status_code>=100 and http_status_code<200 then
			http_interim_response=true
		else
			callback_http_response_code_arrival(code)
			#if HTTP_DEBUG_PRINT
				http_debugprint("Response code:" + code)
			#endif
		end if
		http_request_item.state=HTTP_RESPONSE_PROCESSED

	else if http_line="" then
		http_headers_done()

	else
		b=instr(1,http_line,":",1)	'"Name: value" or "Name:value"
		if b>0 and http_interim_response=false then
			header_type=left(http_line,b-1)
			header_value=mid(http_line,b+1,255)
			while left(header_value,1)=" " or left(header_value,1)=chr(9)
				header_value=mid(header_value,2,255)
			wend
			callback_http_header_arrival(header_type,header_value)
			#if HTTP_DEBUG_PRINT
				http_debugprint("Header> " + header_type + "\t\tValue: " + header_value)
			#endif
			lower_type=header_type
			http_to_lower_case(lower_type)
			lower_value=header_value
			http_to_lower_case(lower_value)
			if lower_type="content-length" then
				http_request_item.remaining_response_content_length=lval(header_value)
				http_chunk_length=http_request_item.remaining_response_content_length
				http_content_length_seen=true
			end if
			if lower_type="transfer-encoding" and instr(1,lower_value,"chunked",1)>0 then
				http_request_item.chunked=true
			end if
		end if
	end if

	http_line=""
	http_get_headers=(http_request_item.state<>FREE)

end function

function http_get_content() as boolean
'Handles one piece of the body. Returns true if something was handled.

	dim data as string
	dim n as byte
	dim p as byte

	http_get_content=false

	if http_request_item.chunked=true and http_chunk_state<>HTTP_CHUNK_DATA then
		if http_read_line()=false then exit function	'line not complete yet: nothing is lost
		http_timer_count=0
		select case http_chunk_state
		case HTTP_CHUNK_SIZE:
			p=instr(1,http_line,";",1)	'drop chunk extensions
			if p>0 then http_line=left(http_line,p-1)
			if http_line<>"" then
				http_request_item.remaining_response_content_length=lval("&h"+http_line)
				http_chunk_length=http_request_item.remaining_response_content_length
				if http_chunk_length=0 then
					http_chunk_state=HTTP_CHUNK_TRAILER
				else
					http_chunk_state=HTTP_CHUNK_DATA
				end if
			end if
		case HTTP_CHUNK_CRLF:
			#if HTTP_DEBUG_PRINT
				http_debugprint("Chunk complete")
			#endif
			http_chunk_state=HTTP_CHUNK_SIZE
		case HTTP_CHUNK_TRAILER:
			if http_line="" then
				http_line=""
				http_request_complete()
				exit function
			end if
		end select
		http_line=""
		http_get_content=true
		exit function
	end if

	if http_body_until_close=false and http_request_item.remaining_response_content_length=0 then
		http_request_complete()
		exit function
	end if

	n=HTTP_MAX_DATA_LENGTH
	if http_body_until_close=false and http_request_item.remaining_response_content_length<n then
		n=http_request_item.remaining_response_content_length
	end if
	data=http_get_data(n)
	if len(data)=0 then exit function
	http_timer_count=0

	if http_body_until_close=false then
		http_request_item.remaining_response_content_length=http_request_item.remaining_response_content_length-len(data)
	end if
	callback_http_content_arrival(data)
	if http_request_item.state<>HTTP_HEADERS_PROCESSED then exit function	'callback started a new request

	#if HTTP_DEBUG_PRINT
		if http_chunk_length>0 then
			dim bytes_received as dword=http_chunk_length - http_request_item.remaining_response_content_length
			if http_request_item.chunked=false then
				http_debugprint(lstr(bytes_received) + " out of " + lstr(http_chunk_length)  + " bytes received\t" + lstr((bytes_received*100)/http_chunk_length) + "%")
			else
				http_debugprint(lstr(bytes_received) + " out of " + lstr(http_chunk_length)  + " bytes in current chunk received\t" + lstr((bytes_received*100)/http_chunk_length) + "%")
			end if
		end if
	#endif

	if http_request_item.chunked=true then
		if http_request_item.remaining_response_content_length=0 then
			http_chunk_state=HTTP_CHUNK_CRLF
		end if
	else if http_body_until_close=false and http_request_item.remaining_response_content_length=0 then
		http_request_complete()
		exit function
	end if
	http_get_content=true

end function

function http_proc_step() as boolean
	http_proc_step=false
	select case http_request_item.state
	case REQUEST_SENT, HTTP_RESPONSE_PROCESSED:
		'(HTTP_RESPONSE_PROCESSED was not handled before: headers split over
		'several data events stopped and the request ended in a timeout)
		http_proc_step=http_get_headers()
	case HTTP_HEADERS_PROCESSED:
		http_proc_step=http_get_content()
	end select
end function

sub http_proc_data()

	if http_start_called=false or http_check_socket_list()=NG then
		exit sub
	end if

	'handle everything that is complete in the RX buffer
	dim i as byte
	for i=1 to HTTP_MAX_STEPS_PER_EVENT
		if http_proc_step()=false then exit for
	next i

end sub

function http_get_domain_name(url as string) as string

	dim b as byte
	if left(url, 7)="http://" then
		http_get_domain_name=right(url,len(url)-7)
	else if left(url, 8)="https://" then
		http_get_domain_name=right(url,len(url)-8)
	else
		http_get_domain_name=""
		exit function
	end if
	b=instr(1,http_get_domain_name,"/",1)
	if b>0 then
		http_get_domain_name=left(http_get_domain_name,b-1)
	end if
	b=instr(1,http_get_domain_name,":",1)
	if b>0 then
		http_get_domain_name=left(http_get_domain_name,b-1)
	end if
	b=instr(1,http_get_domain_name,"?",1)
	if b>0 then
		http_get_domain_name=left(http_get_domain_name,b-1)
	end if
	b=instr(1,http_get_domain_name,"#",1)
	if b>0 then
		http_get_domain_name=left(http_get_domain_name,b-1)
	end if

end function

sub http_init_request_socket()
	dim dns_socket as byte=sock.num
	dim ok_tx, ok_rx as boolean

	#if HTTP_DEBUG_PRINT
		http_debugprint("HTTP sock initialization.")
	#endif
	sock.num=http_request_item.socket
	'drop whatever is left of the previous connection (no blocking wait)
	if sock.statesimple<>PL_SSTS_CLOSED then
		sock.discard()
	end if
	sock.connectiontout=HTTP_TIMEOUT
	sock.targetip=http_request_item.ip
	sock.protocol=PL_SOCK_PROTOCOL_TCP
	sock.inconmode=PL_SOCK_INCONMODE_NONE	'client socket: no incoming connections
	sock.targetport=http_request_item.port
	sock.allowedinterfaces = sock.availableinterfaces
	sock.targetinterface=http_request_item.interface

	'allocate buffers once, not on every request
	if http_buffers_ready=false then
		ok_tx=(sock.txbuffrq(HTTP_TX_BUFF)=HTTP_TX_BUFF)
		ok_rx=(sock.rxbuffrq(HTTP_RX_BUFF)=HTTP_RX_BUFF)
		sys.buffalloc()
		if ok_tx=false then
			http_failed("Not enough space in TX buffer")
			sock.num=dns_socket
			exit sub
		end if
		if ok_rx=false then
			http_failed("Not enough space in RX buffer")
			sock.num=dns_socket
			exit sub
		end if
		http_buffers_ready=true
	end if

#if TLS_AVAILABLE
	if http_request_item.tls=true then
		'Only one TLS session can exist: take it from its current owner (e.g. MQTT).
		'Plain HTTP requests no longer touch TLS, so they don't break an MQTT TLS connection.
		if sock.tlscurrentnum<>255 and sock.tlscurrentnum<>http_request_item.socket then
			sock.num=sock.tlscurrentnum
			sock.tlsdeinit()
			sock.num=http_request_item.socket
		end if
		'release this socket's own TLS session if a previous request left it
		if sock.tlscurrentnum=http_request_item.socket then
			sock.tlsdeinit()
		end if
#if PLATFORM_ID<>WM2000
		'request the TLS buffer for every HTTPS request, as the original library did
		'(tlsdeinit() releases it)
		sock.tlsbuffrq(HTTP_TLS_BUFF_PAGES)
		sys.buffalloc()
#endif
		dim b as pl_tls_result
		b=sock.tlsinit(callback_http_open_romfile())
		if b<>PL_TLS_SUCCESS then
			http_failed("Error loading certificate")
			sock.num=dns_socket
			exit sub
		end if
	end if
#endif

	sock.num=http_request_item.socket
	sock.rxclear()
	sock.txclear()
	#if HTTP_DEBUG_PRINT
		http_debugprint("Connecting to "+sock.targetip+":"+str(sock.targetport))
	#endif
	sock.connect()
	sock.num=dns_socket

end sub

sub http_try_dns()
'Starts the DNS lookup. If the DNS library is busy with another lookup (e.g. for MQTT),
'the request waits and http_proc_timer() tries again on the next tick (within HTTP_TIMEOUT).
	dim status as en_dns_status_codes
	status=dns_connect(http_request_item.interface, HTTP_DNS_SERVER, 0)
	if status=EN_STATUS_DNS_OK then
		http_request_item.state=DNS_REQUEST_SENT
		dns_query(http_request_item.domain_name)
	else if status=EN_STATUS_DNS_REQUEST_IN_PROGRESS then
		http_request_item.state=DNS_NOT_COMPLETE
	else
		http_failed("DNS not available")
	end if
end sub

sub http_start_request()

	dim is_ip_address as boolean=true
	dim b, ascii as byte
	http_request_item.domain_name = http_get_domain_name(http_request_item.url)
	if http_request_item.domain_name="" then
		http_failed("Malformed URL")
		exit sub
	end if
	for b=1 to len(http_request_item.domain_name)
		ascii=asc(mid(http_request_item.domain_name,b,1))
		if ascii<46 or ascii>57 or ascii=47 then	'only digits and dots
			is_ip_address=false
			exit for
		end if
	next b
	if is_ip_address=true then
		http_request_item.ip=http_request_item.domain_name
		http_request_item.state=DNS_COMPLETE
		http_init_request_socket()
	else
		http_try_dns()
	end if

end sub

function http_get_authority(byref url as string) as string
'Returns the "host[:port]" part of the URL
	dim p, e as byte
	p=instr(1,url,"//",1)
	if p=0 then
		http_get_authority=""
		exit function
	end if
	http_get_authority=mid(url,p+2,255)
	e=instr(1,http_get_authority,"/",1)
	if e>0 then http_get_authority=left(http_get_authority,e-1)
	e=instr(1,http_get_authority,"?",1)
	if e>0 then http_get_authority=left(http_get_authority,e-1)
	e=instr(1,http_get_authority,"#",1)
	if e>0 then http_get_authority=left(http_get_authority,e-1)
end function

sub http_set_port()
	dim authority as string = http_get_authority(http_request_item.url)
	dim port as string = ""
	dim b as byte
	dim ascii as byte

	'the port can only be in the host part (a ':' in the path or query is not a port)
	b=instr(1,authority,":",1)
	if b>0 then
		b=b+1
		while b <= len(authority)
			ascii=asc(mid(authority,b,1))
			if ascii>=48 and ascii<=57 then
				port = port + chr(ascii)
				b=b+1
			else
				exit while
			end if
		wend
	end if

	if left(http_request_item.url, 6)="https:" then
		http_request_item.tls=true
		http_request_item.port=443
	else
		http_request_item.tls=false
		http_request_item.port=80
	end if
	if port<>"" then
		http_request_item.port=val(port)
	end if

end sub

sub http_proc_timer()

	if http_start_called=false then
		exit sub
	end if
	'(the DNS phase is now covered too: with no network a request used to wait forever)
	'waiting for the DNS library to become free
	if http_request_item.state=DNS_NOT_COMPLETE and http_request_item.domain_name<>"" then
		http_try_dns()
	end if
	if http_request_item.state<>FREE then
		http_timer_count = http_timer_count + 1
		if http_timer_count > HTTP_TIMEOUT then
			http_failed("Timeout")
		end if
	end if

end sub

function http_get_path(url as string) as string
'Returns "/path?query" for the request line; "/" if the URL has no path
	dim p, b, q as byte
	p=instr(1,url,"//",1)
	if p=0 then
		p=1
	else
		p=p+2
	end if
	b=instr(p,url,"/",1)
	q=instr(p,url,"?",1)
	if b=0 or (q>0 and q<b) then
		if q>0 then
			http_get_path="/"+mid(url,q,255)
		else
			http_get_path="/"
		end if
	else
		http_get_path=mid(url,b,255)
	end if
	b=instr(1,http_get_path,"#",1)	'the fragment is never sent
	if b>0 then http_get_path=left(http_get_path,b-1)

end function

sub http_send_required_data()
	dim path as string
	dim host as string
	sock.num=http_request_item.socket
	path=http_get_path(http_request_item.url)
	http_send_data(http_methods(http_request_item.method) + " " + path)
	if (http_request_item.method=HTTP_GET or http_request_item.method=HTTP_HEAD) and (http_request_item.data<>"") then
		if instr(1,path,"?",1)>0 then
			http_send_data("&" + http_request_item.data)
		else
			http_send_data("?" + http_request_item.data)
		end if
	end if
	http_send_data(" HTTP/1.1\r\n")
	host=http_request_item.domain_name
	if (http_request_item.tls=true and http_request_item.port<>443) or (http_request_item.tls=false and http_request_item.port<>80) then
		host=host+":"+str(http_request_item.port)
	end if
	http_send_headers("Host", host)
	http_send_headers("Connection", "close")	'the library uses one connection per request
	if (http_request_item.method<>HTTP_GET and http_request_item.method<>HTTP_HEAD) then
		http_send_headers("Content-Length",lstr(http_request_item.remaining_content_length))
	end if
end sub

function http_request_merged(method as HTTP_REQUEST_METHODS, byref url as string, interface as pl_sock_interfaces, byref data as string, request_length as dword) as byte

	http_start()
	if http_request_item.state<>FREE then
		http_reset_socket()
		#if HTTP_DEBUG_PRINT
			http_debugprint("Current HTTP request cancelled, starting new request.")
		#endif
	end if
	http_clear_response()
	http_timer_count = 0
	http_request_item.data=data
	http_request_item.url=url
	http_request_item.method=method
	http_request_item.remaining_content_length=request_length
	if request_length=0 then
		http_request_item.long_request=false
		http_request_item.remaining_content_length=len(data)
	else
		http_request_item.long_request=true
	end if
	http_request_merged=http_request_item.socket
	http_request_item.interface=interface
	http_request_item.state=DNS_NOT_COMPLETE	'request is in progress from here on
	http_set_port()
#if TLS_AVAILABLE <> 1
	if http_request_item.tls=true then
		http_failed("Device does not support TLS")
		exit function
	end if
#endif
	http_start_request()

end function

function http_request(method as HTTP_REQUEST_METHODS, byref url as string, interface as pl_sock_interfaces, byref data as string) as byte
''The "Content-Type" header is a requirement for most HTTP requests

	http_request=http_request_merged(method, url, interface, data, 0)

end function

function http_request_long(method as HTTP_REQUEST_METHODS, byref url as string, interface as pl_sock_interfaces, request_length as dword) as byte
'Sends a HTTP request to the specified path on a specified domain name.

	http_request_long=http_request_merged(method, url, interface, "", request_length)

end function

sub http_dns_answer_acquired(return_type as en_dns_return_type, byref return_string as string)

	if http_request_item.state=DNS_REQUEST_SENT then
		if dns_current_domain() = http_request_item.domain_name then
			if(return_type=EN_DNS_RET_IP) then
				http_request_item.ip=ddstr(return_string)
				http_request_item.state=DNS_COMPLETE
				http_timer_count=0
				http_init_request_socket()
			end if
		end if
	end if

end sub

function http_send_post_data(byref data as string) as word
'Returns the number of bytes accepted (was always 0)
	http_send_post_data=0
	if http_request_item.state=FREE then exit function
	http_timer_count = 0
	dim sent as string = data
	if len(sent) > http_request_item.remaining_content_length then
		sent = left(sent,http_request_item.remaining_content_length)
	end if
	http_send_data(sent)
	if http_request_item.state=FREE then exit function	'send failed
	http_request_item.remaining_content_length=http_request_item.remaining_content_length-len(sent)
	http_send_post_data=len(sent)
	#if HTTP_DEBUG_PRINT
		http_debugprint("Remaining data length: " + lstr(http_request_item.remaining_content_length))
	#endif
	sock.num=http_request_item.socket
	sock.notifysent(255)

end function

function http_encode_url(unencoded_url as string) as string
'Percent-encodes everything except the unreserved characters A-Z a-z 0-9 - _ . ~
'(the result is limited to 255 characters)

	dim i, n as byte
	dim chr_hex as string
	http_encode_url=""
	for i = 1 to len(unencoded_url)
		n = asc(mid(unencoded_url,i,1))
		if (n >= 48 and n <= 57) or (n >= 65 and n <= 90) or (n >= 97 and n <= 122) or n=45 or n=46 or n=95 or n=126 then
			http_encode_url = http_encode_url + chr(n)
		else
			'(bytes above 127, e.g. UTF-8, are encoded too instead of being dropped)
			chr_hex = hex(n)
			chr_hex = right(chr_hex,len(chr_hex)-2)
			if len(chr_hex)=1 then chr_hex="0"+chr_hex
			http_encode_url = http_encode_url + "%" + chr_hex
		end if
	next i

end function

sub http_dns_failure()
	if http_request_item.state<>DNS_REQUEST_SENT then
		exit sub
	end if
	if http_request_item.domain_name<>dns_current_domain() then
		exit sub
	end if
	http_failed("DNS failure")
end sub

sub http_sock_state_update(newstatesimple as enum pl_sock_state_simple)

	if http_start_called=false then
		exit sub
	end if
	if http_check_socket_list()=NG then
		exit sub
	end if
	if http_request_item.state=FREE then
		exit sub
	end if

	if newstatesimple=PL_SSTS_CLOSED then
		'(this was never reached before: refused or dropped connections waited for the timeout)
		if sock.statesimple<>PL_SSTS_CLOSED then exit sub	'late event: a new connection is already under way
		if http_request_item.state<DNS_COMPLETE then exit sub	'no connection in use yet
		'the server often sends the response and closes at once: handle what arrived first
		http_proc_data()
		if http_request_item.state=FREE then exit sub
		if http_request_item.state=HTTP_HEADERS_PROCESSED and http_body_until_close=true then
			http_request_complete()
		else
			http_failed("Connection closed")
		end if
		exit sub
	end if

	if newstatesimple<>PL_SSTS_EST then
		exit sub
	end if
	if http_request_item.state>=REQUEST_SENT then
		exit sub
	end if

	if http_request_item.tls=true then
#if TLS_AVAILABLE
		dim handshake_res as pl_tls_result
		if sock.state=PL_SST_EST_AOPENED then
			'check if domain name is ip
			if http_request_item.domain_name <> http_request_item.ip then
				handshake_res = sock.tlshandshake(http_request_item.domain_name)
			else
				handshake_res = sock.tlshandshake("")
			end if
			if handshake_res<>PL_TLS_SUCCESS then
				http_failed("Handshake Error")
				exit sub
			end if
		end if

		if sock.state<>PL_SST_EST_TLS then
			exit sub
		end if

#else
		http_failed("HTTPS not available")
		exit sub
#endif
	end if
	if http_request_item.state<=REQUEST_SENT then
		http_timer_count=0
		http_send_required_data()
		if http_request_item.state=FREE then exit sub
		callback_http_send_headers()
		if http_request_item.state=FREE then exit sub
		http_send_data("\r\n")
		if http_request_item.state=FREE then exit sub
		if http_request_item.method<>HTTP_GET and http_request_item.method<>HTTP_HEAD then
			if http_request_item.long_request=false then
				http_send_data(http_request_item.data)
				if http_request_item.state=FREE then exit sub
				http_request_item.state=REQUEST_SENT
			else
				callback_http_send_post_data(http_request_item.remaining_content_length)
			end if
		else
			http_request_item.state=REQUEST_SENT
		end if
	end if
end sub

sub http_send_headers(header_name as string, header_value as string)

	http_send_data(header_name + ": " + header_value + "\r\n")

end sub


sub http_on_sock_data_sent()

	if http_check_socket_list()=NG then
		exit sub
	end if
	if http_request_item.long_request=false or http_request_item.state<>DNS_COMPLETE then
		exit sub
	end if
	if http_request_item.remaining_content_length>0 then
		callback_http_send_post_data(http_request_item.remaining_content_length)
	else
		callback_http_post_data_sent_ok()
		http_request_item.state=REQUEST_SENT
		#if HTTP_DEBUG_PRINT
			http_debugprint("HTTP Post Data Sent")
		#endif
		'the response may already be waiting
		http_proc_data()
	end if

end sub
