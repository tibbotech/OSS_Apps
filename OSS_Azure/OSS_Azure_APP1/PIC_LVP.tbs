' Rewinds the HEX reader to the beginning of the opened romfile
'
sub hex_rewind()
	hx_p = 0
	hx_lba = 0
	hx_rlen = 0
	hx_idx = 0
	hx_err = false
	pend_valid = false
end sub

' Returns the next data word of the HEX file.
'   kind = HX_PGM   : addr is the program memory word address
'   kind = HX_CFG   : addr is the offset from 0x8000 (user ID / config)
'   kind = HX_EE    : addr is the EEPROM byte index
'   kind = HX_OTHER : anything else
' Returns false at end of file, or on error (then hx_err = true).
'
function hex_next_word(byref addr as word, byref value as word, byref kind as byte) as boolean

	dim e as dword
	dim rtyp as byte

	hex_next_word = false

	while hx_idx >= hx_rlen / 2
		' Find Start-Of-Record mark
		hx_p = romfile.find32(hx_p, ":", 1)
		if hx_p = 0 then
			exit function
		end if

		' Find end of line
		e = romfile.find32(hx_p, hx_crlf, 1)
		if e = 0 then
			e = romfile.size
		end if

		if e - hx_p > PIC_LVP_MAX_REC_LEN then
			hx_err = true
			exit function
		end if

		romfile.pointer32 = hx_p
		hx_rec = romfile.getdata(e - hx_p)
		hx_p = e + hx_crlfsize

		hx_rlen = val("&h" + mid(hx_rec, 2, 2))
		hx_offs = val("&h" + mid(hx_rec, 4, 4))
		rtyp = val("&h" + mid(hx_rec, 8, 2))
		hx_idx = 0

		select case rtyp
		case &h00: ' DATA
			if hx_rlen mod 2 <> 0 then
				hx_err = true
				exit function
			end if

		case &h01: ' EOF
			hx_rlen = 0
			exit function

		case &h04: ' Extended Linear Address
			if hx_rlen <> 2 then
				hx_err = true
				exit function
			end if
			hx_lba = val("&h" + mid(hx_rec, 10, 4))
			hx_lba = hx_lba shl 16
			hx_rlen = 0

		case else: ' 02, 03, 05: no data we need
			hx_rlen = 0
		end select
	wend

	addr = hx_offs / 2 + hx_idx
	value = val("&h" + mid(hx_rec, 10 + hx_idx * 4, 4))
	hx_idx = hx_idx + 1

	kind = HX_OTHER
	if hx_lba = 0 then
		kind = HX_PGM
	else if hx_lba = &h10000 then
		if hx_offs >= &hE000 then
			kind = HX_EE
			addr = addr - &h7000
		else
			kind = HX_CFG
		end if
	end if

	hex_next_word = true

end function

' Returns the next program memory word, skipping config/EEPROM words
'
function hex_next_pgm_word(byref addr as word, byref value as word) as boolean

	dim k as byte

	hex_next_pgm_word = false

	while hex_next_word(addr, value, k)
		if k = HX_PGM then
			hex_next_pgm_word = true
			exit function
		end if
	wend

end function

' Fills row_buf with the next 32-word row that contains data.
' Words not present in the HEX file are left blank (&hFF3F = 0x3FFF swapped).
' Requires program records in ascending row order (checked by load_firmware).
'
function hex_next_row(byref row as word) as boolean

	dim a, v as word
	dim j as byte

	hex_next_row = false

	if not pend_valid then
		if not hex_next_pgm_word(pend_addr, pend_val) then
			exit function
		end if
	end if
	pend_valid = false

	row = pend_addr and &hFFE0
	for j = 0 to 31
		row_buf(j) = &hFF3F
	next j
	row_buf(pend_addr and 31) = pend_val

	while hex_next_pgm_word(a, v)
		if (a and &hFFE0) <> row then
			' First word of the next row: keep it for the next call
			pend_addr = a
			pend_val = v
			pend_valid = true
			exit while
		end if
		row_buf(a and 31) = v
	wend

	hex_next_row = true

end function

' Opens and validates the .HEX file and collects config words and EEPROM data.
' Program memory is not stored; it is streamed later by program_programm().
' The romfile must stay open until programming is finished.
'
function load_firmware(byref name as string, byref fw as firmware) as boolean

	dim i, a, v, last_row as word
	dim k as byte

	load_firmware = false

#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("Parsing HEX file\r\n")
#endif

	fw.eepromlen = 0
	for i = 0 to PIC_LVP_MAX_EEPROM_LEN - 1
		fw.eeprom(i) = &hFF
	next i
	for i = 0 to PIC_LVP_MAX_CFG_LEN - 1
		fw.config(i) = &hFF3F
	next i

	romfile.open(name)
	if romfile.size = 0 then
		exit function
	end if

	' Determine, whether line endings in hex file is Windows-style or Unix-style
	if 0 = romfile.find32(0, "\r\n", 1) then
		hx_crlf = "\n"
		hx_crlfsize = 1
	else
		hx_crlf = "\r\n"
		hx_crlfsize = 2
	end if

	hex_rewind()
	last_row = 0

	while hex_next_word(a, v, k)
		select case k
		case HX_PGM:
			' Streaming needs rows in ascending order (XC8/MPLAB output is sorted)
			if (a and &hFFE0) < last_row then
#if PIC_LVP_DEBUG_PRINT
				sys.debugprint("HEX file is not sorted by address\r\n")
#endif
				exit function
			end if
			last_row = a and &hFFE0

		case HX_CFG:
			if a < PIC_LVP_MAX_CFG_LEN then
				fw.config(a) = v
			end if

		case HX_EE:
			if a < PIC_LVP_MAX_EEPROM_LEN then
				fw.eeprom(a) = swab(v)
				if a + 1 > fw.eepromlen then
					fw.eepromlen = a + 1
				end if
			end if
		end select
	wend

	if hx_err then
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint("HEX file is malformed\r\n")
#endif
		exit function
	end if

	load_firmware = true

end function

function program_user_id(byref fw as firmware, n as byte, nn as byte, options as byte) as boolean

	dim i, j as word
	dim temp as word
	
	program_user_id = false
	
#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("USER ID. TRY " + str(n) + " OF " + str(nn) + "\r\n")
	sys.debugprint(" Uploading ")
#endif

	select case options
	case 0:
	case 2:
		' Set config address space
		pic_command(CMD_LOAD_CONFIG)
		pic_recv_bits()
		
		for i = 0 to PIC_LVP_MAX_USER_ID_LEN - 1
	#if PIC_LVP_DEBUG_PRINT
			sys.debugprint("#")
	#endif
			if pic_send_cfg_word(swab(fw.config(i))) <> true then
				exit function
			end if
		next i

	case 1:
			' NEW PIC
			pic_command_payload_new(NEW_CMD_LOAD_PC_ADDRESS, &h8000)
			
			for i = 0 to PIC_LVP_MAX_USER_ID_LEN - 1
				pic_command_payload_new(NEW_CMD_LOAD_DATA_FOR_NVM, swab(fw.config(i)))
				pic_command_new(NEW_CMD_BEGIN_INTERNALLY_TIMED_PROGRAMMING)
				for j = 0 to 1000
				next j
				pic_command_new(NEW_CMD_INCREMENT_ADDRESS)
			next i

			' Verify
			pic_command_payload_new(NEW_CMD_LOAD_PC_ADDRESS, &h8000)	' Configs address
			
			for i = 0 to PIC_LVP_MAX_USER_ID_LEN - 1
				temp = swab(pic_command_payload_get_new(NEW_CMD_READ_DATA_FROM_NVM_INC))
				if temp <> fw.config(i) then
	#if PIC_LVP_DEBUG_PRINT
					sys.debugprint("\r\n Data check error: " + hex(i+&h8007) + ": read " + hex(swab(temp)) + ", expected " + hex(swab(fw.config(i))) + "\r\n")
	#endif
					exit function
				end if
			next i

	end select

program_user_id = true

#if PIC_LVP_DEBUG_PRINT
		sys.debugprint("\r\n Success\r\n")
#endif

end function

function program_config_words(byref fw as firmware, n as byte, nn as byte, options as byte) as boolean
	
	dim i, j as word
	dim config0, config1 as word
	dim temp as word
	
	program_config_words = false
	
#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("CONFIGURATION WORDS. TRY " + str(n) + " OF " + str(nn) + "\r\n")
	sys.debugprint(" Uploading ")
#endif

	select case options 
	case 0:
		pic_command(CMD_RESET_ADDRESS)

		pic_command(CMD_LOAD_CONFIG) 
		pic_recv_bits()

		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8001
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8002
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8003
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8004
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8005
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8006
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8007

		' Config words 1 and 2
		'
		config0 = swab(fw.config(7)) and &h3FFF
		config1 = swab(fw.config(8)) and &h3FFF
		
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint(" CONFIG1 and CONFIG2 words are " + hex(config0) + " and " + hex(config1) + "\r\n")
#endif
		
		if pic_send_cfg_word(config0) <> true then			' 0x8007
			exit function
		end if
		if pic_send_cfg_word(config1) <> true then			' 0x8008
			exit function
		end if
	
	case 2:
		pic_load_pc_address(0)

		pic_command(CMD_LOAD_CONFIG) 
		pic_recv_bits()

		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8001
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8002
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8003
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8004
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8005
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8006
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8007

		' Config words 1 and 2
		'
		config0 = swab(fw.config(7)) and &h3FFF
		config1 = swab(fw.config(8)) and &h3FFF
		
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint(" CONFIG1 and CONFIG2 words are " + hex(config0) + " and " + hex(config1) + "\r\n")
#endif
		
		if pic_send_cfg_word(config0) <> true then			' 0x8007
			exit function
		end if
		if pic_send_cfg_word(config1) <> true then			' 0x8008
			exit function
		end if
	
	case 1:
		pic_command_payload_new(NEW_CMD_LOAD_PC_ADDRESS, &h8007)	' Configs address
		
		for i = 0 to 3
			pic_command_payload_new(NEW_CMD_LOAD_DATA_FOR_NVM, swab(fw.config(i + 7)))
			pic_command_new(NEW_CMD_BEGIN_INTERNALLY_TIMED_PROGRAMMING)
			for j = 0 to 1000
			next j
			pic_command_new(NEW_CMD_INCREMENT_ADDRESS)
		next i
		
		' Verify
		pic_command_payload_new(NEW_CMD_LOAD_PC_ADDRESS, &h8007)	' Configs address
		
		for i = 0 to 3
			temp = swab(pic_command_payload_get_new(NEW_CMD_READ_DATA_FROM_NVM_INC))
			if temp <> fw.config(i + 7) then
#if PIC_LVP_DEBUG_PRINT
				sys.debugprint("\r\n Data check error: " + hex(i+&h8007) + ": read " + hex(swab(temp)) + ", expected " + hex(swab(fw.config(i+7))) + "\r\n")
#endif
				exit function
			end if
		next i
		
	end select
	
	program_config_words = true

#if PIC_LVP_DEBUG_PRINT
	sys.debugprint(" Success\r\n")
#endif

end function

' Resets the PIC address pointer tracking
'
sub pic_reset_pc(options as byte)
	if options = 0 then
		pic_command(CMD_RESET_ADDRESS)
	end if
	pic_pc = 0
end sub

' Moves the PIC address pointer to addr.
' Old PICs (options 0) have no LOAD_PC command, so they can only move forward
' with INCREMENT_ADDRESS. Rows come in ascending order, so this is enough.
'
sub pic_goto(addr as word, options as byte)

	select case options
	case 0:
		while pic_pc < addr
			pic_command(CMD_INCREMENT_ADDRESS)
			pic_pc = pic_pc + 1
		wend

	case 1:
		pic_command_payload_new(NEW_CMD_LOAD_PC_ADDRESS, addr)

	case 2:
		pic_load_pc_address(addr)

	end select

	pic_pc = addr

end sub

' Programs row_buf into the 32-word row starting at 'row'
'
sub pic_write_row(row as word, options as byte)

	dim j as byte

	pic_goto(row, options)

	select case options
	case 0, 2:
		for j = 0 to 31
			pic_send_pgm_word(row_buf(j), j < 31, options)
		next j
		pic_command(CMD_BEGIN_INTERNALLY_TIMED_PROGRAMMING)
		pic_command(CMD_INCREMENT_ADDRESS)

	case 1:
		for j = 0 to 31
			if j < 31 then
				pic_command_payload_new(NEW_CMD_LOAD_DATA_FOR_NVM_INC, swab(row_buf(j)))
			else
				pic_command_payload_new(NEW_CMD_LOAD_DATA_FOR_NVM, swab(row_buf(j)))
			end if
		next j
		pic_command_new(NEW_CMD_BEGIN_INTERNALLY_TIMED_PROGRAMMING)
		pic_command_new(NEW_CMD_INCREMENT_ADDRESS)

	end select

	pic_pc = row + 32

end sub

' Reads the 32-word row starting at 'row' and compares it with row_buf
'
function pic_verify_row(row as word, options as byte) as boolean

	dim j as byte
	dim temp as word

	pic_verify_row = false

	pic_goto(row, options)

	for j = 0 to 31
		select case options
		case 0, 2:
			temp = pic_recv_pgm_word(options)

		case 1:
			temp = swab(pic_command_payload_get_new(NEW_CMD_READ_DATA_FROM_NVM_INC))

		end select

		if temp <> row_buf(j) then
#if PIC_LVP_DEBUG_PRINT
			sys.debugprint("\r\n Data check error: "+hex(row+j)+": read "+hex(swab(temp))+", expected "+hex(swab(row_buf(j)))+"\r\n")
#endif
			exit function
		end if
	next j

	pic_pc = row + 32

	pic_verify_row = true

end function

' Programs and verifies program memory, streaming it from the HEX file.
' RAM used: one 32-word row buffer instead of the whole program image.
'
function program_programm(byref fw as firmware, n as byte, nn as byte, options as byte) as boolean

	dim row as word

	program_programm = false

#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("PROGRAMM MEMORY. TRY " + str(n) + " OF " + str(nn) + "\r\n")
	sys.debugprint(" Uploading ")
#endif

	pic_reset_pc(options)
	hex_rewind()

	while hex_next_row(row)
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint("#")
#endif
		pic_write_row(row, options)
	wend

	if hx_err then
		exit function
	end if

#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("\r\n Verifying ")
#endif

	pic_reset_pc(options)
	hex_rewind()

	while hex_next_row(row)
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint("#")
#endif
		if not pic_verify_row(row, options) then
			exit function
		end if
	wend

	if hx_err then
		exit function
	end if

#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("\r\n Success\r\n")
#endif

	program_programm = true

end function

function program_data(byref fw as firmware, n as byte, nn as byte, options as byte) as boolean
	
	dim i as word
	dim temp as byte
	
	program_data = false

#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("DATA MEMORY. TRY " + str(n) + " OF " + str(nn) + "\r\n")
#endif

	select case options
	case 0:
		pic_command(CMD_LOAD_CONFIG) 
		pic_recv_bits()
	
	case 2:
		'pic_command(CMD_LOAD_CONFIG) 
		pic_load_pc_address(&hF000)
		
	case 1:
		pic_command_payload_new(NEW_CMD_LOAD_PC_ADDRESS, &hf000)	'EEPROM address
		
	end select
	
#if PIC_LVP_DEBUG_PRINT
	sys.debugprint(" Uploading ")
#endif

	for i = 0 to fw.eepromlen - 1
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint("#")
#endif

		select case options
		case 0:
			pic_send_data_byte(fw.eeprom(i))
			pic_command(CMD_BEGIN_EXTERNALLY_TIMED_PROGRAMMING)
			pic_command(CMD_END_EXTERNALLY_TIMED_PROGRAMMING)

		case 2:
			pic_send_ee_word(fw.eeprom(i))
			pic_command(CMD_BEGIN_INTERNALLY_TIMED_PROGRAMMING)
		
		case 1:
			pic_command_payload_new(NEW_CMD_LOAD_DATA_FOR_NVM, fw.eeprom(i))
			pic_command_new(NEW_CMD_BEGIN_INTERNALLY_TIMED_PROGRAMMING)
			
		end select

		' Verify
		
		select case options
		case 0:
			temp = pic_recv_data_byte()
			
		case 2:
			temp = pic_read_ee_word()
		
		case 1:
			temp = pic_command_payload_get_new(NEW_CMD_READ_DATA_FROM_NVM_INC)
			
		end select

		if fw.eeprom(i) <> temp then
#if PIC_LVP_DEBUG_PRINT
			sys.debugprint("\r\n Data check error: "+hex(i)+": read "+hex(temp)+", expected "+hex(fw.eeprom(i))+"\r\n")
#endif
			exit function
		end if
		select case options
		case 0:
			pic_command(CMD_INCREMENT_ADDRESS)
			
		case 2:
		
		case 1:
			
		end select

	next i

#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("\r\n Success\r\n")
#endif
	
	program_data = true
	
end function

function check_pic(options as byte) as boolean
	
	dim pic as word
	dim rev as byte
	dim model as string(10)
	dim mask as word
	dim config1 as word
	dim config2 as word
	
	check_pic = false
	
#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("PIC CHECKING\r\n")
#endif

	select case options
	case 0
	case 2
		' Set config address space
		pic_command(CMD_LOAD_CONFIG)
		pic_recv_bits()
		
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8001
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8002
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8003
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8004
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8005
		pic_command(CMD_INCREMENT_ADDRESS)	' 0x8006

		pic = pic_recv_cfg_word(options)
		config1 = pic_recv_cfg_word(options)
		config2 = pic_recv_cfg_word(options)
		
		if pic_id(pic, model, rev, options, mask) = true then
#if PIC_LVP_DEBUG_PRINT
			sys.debugprint(" Detected old " + model + " revision " + str(rev) + "\r\n")
#endif
			if (pic and mask) <> PIC_LVP_TARGET_TYPE then
#if PIC_LVP_DEBUG_PRINT
				sys.debugprint(" Wrong PIC!!!\r\n")
#endif
				exit function
			end if
		else
#if PIC_LVP_DEBUG_PRINT
			sys.debugprint(" Not detected! PIC is not connected or LVP is disabled\r\n")
#endif
			exit function
		end if
	
	case 1
		pic_command_payload_new(NEW_CMD_LOAD_PC_ADDRESS, &h8006)	  ' ID device address
		pic = pic_command_payload_get_new(NEW_CMD_READ_DATA_FROM_NVM) ' Get data
		
		if pic_id(pic, model, rev, options, mask) = true then
			' New PIC detected
			
#if PIC_LVP_DEBUG_PRINT
			sys.debugprint(" Detected new " + model + "\r\n")
#endif
			if pic <> PIC_LVP_TARGET_TYPE then
#if PIC_LVP_DEBUG_PRINT
				sys.debugprint(" Wrong PIC!!!\r\n")
#endif
				exit function
			end if
		else
#if PIC_LVP_DEBUG_PRINT
			sys.debugprint(" Not detected! PIC is not connected or LVP is disabled\r\n")
#endif
			exit function
		end if
	end select
	
	check_pic = true

end function

sub pic_dump_eeprom()

	dim i, temp as byte
	
	sys.debugprint("DATA DUMP\r\n")

	pic_command(CMD_RESET_ADDRESS)
	
	for i = 0 to 15
		temp = pic_recv_data_byte()
		sys.debugprint(hex(temp) + " ")
		pic_command(CMD_INCREMENT_ADDRESS)
	next i

	sys.debugprint("\r\n")

end sub

function program_firmware(byref fw as firmware) as boolean

	dim try as byte
	dim options as byte
	dim mask as word
	dim name as string(20)
	dim rev as byte

	program_firmware = false
	
	if pic_id(PIC_LVP_TARGET_TYPE, name, rev, options, mask) <> true then
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint("Unknown TARGET PIC\r\n")
#endif
	exit function
	end if
	
	pic_do_reset()
	
	pic_delay_ms(25)

	pic_enter_lvp_mode(options)

#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("LVP mode entered\r\n")
#endif

	if check_pic(options) <> true then
		pic_leave_lvp_mode()
		exit function
	end if
	
#if PIC_LVP_DEBUG_PRINT
	sys.debugprint("Erasing device\r\n")
#endif

	pic_bulk_erase_device(options)

	for try = 1 to PIC_LVP_MAX_TRY_FLASHING
		if program_programm(fw, try, PIC_LVP_MAX_TRY_FLASHING, options) = true then
			try = PIC_LVP_MAX_TRY_FLASHING
		else 
			if try = PIC_LVP_MAX_TRY_FLASHING then
				pic_leave_lvp_mode()
				exit function
			end if
			
			pic_leave_lvp_mode()
			pic_do_reset()
			pic_delay_ms(25)
			pic_enter_lvp_mode(options)
			pic_bulk_erase_device(options)

		end if
	next try

	for try = 1 to PIC_LVP_MAX_TRY_FLASHING
		if program_user_id(fw, try, PIC_LVP_MAX_TRY_FLASHING, options) = true then
			try = PIC_LVP_MAX_TRY_FLASHING
		else 
			if try = PIC_LVP_MAX_TRY_FLASHING then
				pic_leave_lvp_mode()
				exit function
			end if
		end if
	next try

	if fw.eepromlen > 0 then
		for try = 1 to PIC_LVP_MAX_TRY_FLASHING
			if program_data(fw, try, PIC_LVP_MAX_TRY_FLASHING, options) = true then
				try = PIC_LVP_MAX_TRY_FLASHING
			else 
				if try = PIC_LVP_MAX_TRY_FLASHING then
					pic_leave_lvp_mode()

					' EEPROM DUMP
					'pic_enter_lvp_mode()
					'pic_dump_eeprom()
					'pic_leave_lvp_mode()
					exit function
				end if

				pic_erase_data()

			end if
		next try
	end if
	
	for try = 1 to PIC_LVP_MAX_TRY_FLASHING
		if program_config_words(fw, try, PIC_LVP_MAX_TRY_FLASHING, options) = true then
			try = PIC_LVP_MAX_TRY_FLASHING
		else 
			if try = PIC_LVP_MAX_TRY_FLASHING then
				pic_leave_lvp_mode()
				exit function
			end if
		end if
	next try

	pic_leave_lvp_mode()

	pic_delay_ms(25)

	pic_do_reset()
	
	' EEPROM DUMP
	'pic_enter_lvp_mode()
	'pic_dump_eeprom()
	'pic_leave_lvp_mode()

	program_firmware = true

end function


function pic_lvp_upload_firmware(byref fwname as string) as boolean

	dim fw as firmware
	
	if not load_firmware(fwname, fw) then
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint("HEX FILE ERROR\r\n")
#endif
		pic_lvp_upload_firmware = false
		exit function
	end if
	if not program_firmware(fw) then
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint("UPLOADING FAILED\r\n")
#endif
		pic_lvp_upload_firmware = false
	else
#if PIC_LVP_DEBUG_PRINT
		sys.debugprint("PROGRAMMING IS DONE\r\n")
#endif
		pic_lvp_upload_firmware = true
	end if
	
end function

sub pic_lvp_start(SCL as byte, SDA as byte, MCLR as byte) 

	icsp_scl  = SCL
	icsp_sda  = SDA
	icsp_mclr = MCLR

	io.num = icsp_mclr
	io.enabled = YES
	io.state = HIGH

	io.num = icsp_scl
	io.enabled = YES
	io.state = LOW

	io.num = icsp_sda
	io.enabled = YES
	io.state = LOW

end sub
