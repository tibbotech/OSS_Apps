include "global.tbh"

'http://docs.oasis-open.org/mqtt/mqtt/v3.1.1/mqtt-v3.1.1.html
'https://www.hivemq.com/blog/mqtt-essentials-part-6-mqtt-quality-of-service-levels/

const MQTT_INIT_SIGNATURE=&h1688
const MQTT_STAMP="MQTT> "
const MQTT_CR_LF=chr(13)+chr(10)
const MQTT_TIMEOUT=2000
const MQTT_MAX_PACKETS_PER_EVENT=32

'mqtt protocol string
const MQTT_LEVEL	=&h04
const MQTT_PROTOCOL	="MQTT"

'RETAIN bit of outgoing PUBLISH packets (see MQTT_RETAIN in mqtt.tbh)
#if MQTT_RETAIN
	const MQTT_RETAIN_BIT=1
#else
	const MQTT_RETAIN_BIT=0
#endif

enum en_mqtt_message_types

	CONNECT=&h10
	CONNACK=&h20
	PUBLISH=&h30
	PUBACK=&h40
	PUBREC=&h50
	PUBREL=&h60
	PUBCOMP=&h70
	SUBSCRIBE=&h80
	SUBACK=&h90
	UNSUBSCRIBE=&hA0
	UNSUBACK=&hB0
	PINGREQ=&hC0
	PINGRESP=&hD0
	DISCONNECT=&hE0

end enum

enum en_mqtt_proc_data_states

	EN_MQTT_PD_STATES_READING_HEADER,
	EN_MQTT_PD_STATES_READING_PAYLOAD,
	EN_MQTT_PD_STATES_READING_PAYLOAD_DATA

end enum

type mqtt_proc_data_variable

	message_type as en_mqtt_message_types
	topic_length as word
	topic as string
	qos as en_qos_choices
	remaining_length as word
	fixed_header_length as word
	packet_identifier as string

end type

dim proc_data_state as en_mqtt_proc_data_states
dim mqtt_proc_data_variables as mqtt_proc_data_variable
dim mqtt_init_flag as word
dim mqtt_packet_identifier as word
dim mqtt_sock_num as byte = 255
dim mqtt_state as en_mqtt_states
dim mqtt_connection_counter as word
dim mqtt_ping_counter as word
dim mqtt_server_port as word
dim mqtt_server_address as string
dim mqtt_server_ip as string(15)
dim mqtt_user as string
dim mqtt_pw	as string
dim mqtt_packet_length as long
dim mqtt_client_id as string=""
dim mqtt_target_interface as pl_sock_interfaces
dim mqtt_encrypted as boolean
dim mqtt_unreplied_ping_count as byte=0
dim mqtt_tls_buff_ready as boolean=false
dim mqtt_dns_waiting as boolean=false	'DNS library busy with another lookup: retry on the next tick

declare sub mqtt_connect_socket()
declare sub mqtt_set_lost()
declare sub mqtt_drop_connection()
declare function mqtt_proc_packet() as boolean

#if MQTT_DEBUG_PRINT
	declare sub mqtt_debugprint(data as string)
#endif

'-------------------------------------------------------------
sub mqtt_start(target_interface as pl_sock_interfaces, byref server as string, dst_port as word, byref user as string, byref password as string, byref client_id as string, encrypted as boolean)
'API procedure, starts the MQTT library.
'MUST be called first, before any other procedure in this library is used.

	if mqtt_init_flag=MQTT_INIT_SIGNATURE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("MQTT library already initialized.")
		#endif
		exit sub
	end if

	#if MQTT_DEBUG_PRINT
		mqtt_debugprint("---START---")
	#endif

	#if TLS_AVAILABLE=0
		if encrypted=true then
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("Device does not support TLS")
			#endif
			exit sub
		end if
	#endif

	'Check memory before anything is set up, so a failed start leaves the library not started
	if sys.freebuffpages<MQTT_RX_BUFF+MQTT_TX_BUFF then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("Insufficient buffer memory.")
		#endif
		exit sub
	end if

	mqtt_packet_identifier=0
	mqtt_sock_num=sock_get("MQT")
    mqtt_target_interface=target_interface
	mqtt_server_port=dst_port
	mqtt_server_address=server
	mqtt_server_ip=""
    mqtt_user=user
    mqtt_pw=password
	mqtt_encrypted=encrypted
    if client_id<>"" then mqtt_client_id=client_id
	sock.num=mqtt_sock_num
	sock.targetinterface=target_interface
	sock.targetport=dst_port
	sock.protocol=PL_SOCK_PROTOCOL_TCP
	sock.inconmode=PL_SOCK_INCONMODE_NONE	'client socket: don't accept incoming connections
	sock.gendataarrivalevent=YES
	sock.reconmode=PL_SOCK_RECONMODE_3
	sock.connectiontout=MQTT_PING_TIMER*2+20
	sock.rxbuffrq(MQTT_RX_BUFF)
	sock.txbuffrq(MQTT_TX_BUFF)
	sys.buffalloc()

	proc_data_state=EN_MQTT_PD_STATES_READING_HEADER
	mqtt_unreplied_ping_count=0
	mqtt_state=EN_MQTT_STATES_NOT_CONNECTED
	mqtt_init_flag=MQTT_INIT_SIGNATURE
	mqtt_connect()

end sub


function mqtt_build_remaining_length(size as dword) as string(4)
'MQTT remaining length: 1 to 4 bytes, 7 bits each
	mqtt_build_remaining_length = ""
	do
		dim encodedByte as byte = size mod 128
		size = size / 128
		if (size > 0) then encodedByte = encodedByte or 128
		mqtt_build_remaining_length = mqtt_build_remaining_length + chr(encodedByte)
	loop while (size > 0)
end function

function mqtt_get_packet_identifier() as string(2)
	mqtt_packet_identifier = (mqtt_packet_identifier mod 65535) + 1
	mqtt_get_packet_identifier = chr(mqtt_packet_identifier/256)+chr(mqtt_packet_identifier mod 256)
end function


function mqtt_sock_getdata(byref maxinplen as word) as string
if mqtt_encrypted then
#if TLS_AVAILABLE
	mqtt_sock_getdata=sock.tlsgetdata(maxinplen)
#endif
else
	mqtt_sock_getdata=sock.getdata(maxinplen)
end if
end function

function mqtt_sock_peekdata (byref maxinplen as word) as string
if mqtt_encrypted=true then
#if TLS_AVAILABLE
	mqtt_sock_peekdata =sock.tlspeekdata(maxinplen)
#endif
else
	mqtt_sock_peekdata  =sock.peekdata(maxinplen)
end if
end function

function mqtt_sock_peeklen() as dword
if mqtt_encrypted=true then
#if TLS_AVAILABLE
	mqtt_sock_peeklen=sock.tlsrxlen
#endif
else
	mqtt_sock_peeklen=sock.rxlen
end if
end function

sub mqtt_sock_skip(count as dword)
'Removes count bytes from the RX buffer (data that doesn't fit a string)
	dim n as word
	dim s as string
	while count>0
		n=255
		if count<n then n=count
		s=mqtt_sock_getdata(n)
		if len(s)=0 then exit sub
		count=count-len(s)
	wend
end sub

sub mqtt_send_login()
	dim buf as string
	dim flags as byte
	dim keepalive as word
	dim size as dword

	'Keep alive (seconds) follows the ping interval: we ping twice per keep alive period.
	'The broker closes the connection after 1.5 x keep alive without packets from us.
	keepalive=MQTT_PING_TIMER*2

	'Clean session (&h02) in both cases. Without it the session is persistent, which is
	'not allowed with an empty client ID and makes the broker queue messages while offline.
	flags=&h02
	if mqtt_user<>"" then flags=&hC2	'+ user name + password

	buf=chr(&h0)+chr(len(MQTT_PROTOCOL))+MQTT_PROTOCOL+chr(MQTT_LEVEL)+chr(flags)+chr(keepalive/256)+chr(keepalive mod 256)
	size=len(buf)+2+len(mqtt_client_id)
	if mqtt_user<>"" then
		size=size+2+len(mqtt_user)+2+len(mqtt_pw)
	end if

	mqtt_send_data(chr(CONNECT)+mqtt_build_remaining_length(size))
	mqtt_send_data(buf)
	mqtt_send_data(chr(0)+chr(len(mqtt_client_id)))
	mqtt_send_data(mqtt_client_id)
	if mqtt_user<>"" then
		mqtt_send_data(chr(0)+chr(len(mqtt_user)))
		mqtt_send_data(mqtt_user)
		mqtt_send_data(chr(0)+chr(len(mqtt_pw)))
		mqtt_send_data(mqtt_pw)
	end if
end sub

sub mqtt_set_lost()
'Marks the connection as lost and schedules a reconnect.
'callback_mqtt_connect_lost() is called once per lost connection.
	if mqtt_state=EN_MQTT_STATES_IDLE then exit sub
	if mqtt_state=EN_MQTT_STATES_NOT_CONNECTED then exit sub
	if mqtt_state=EN_MQTT_STATES_DNS_NOT_COMPLETE then exit sub

	mqtt_state=EN_MQTT_STATES_NOT_CONNECTED
	mqtt_connection_counter=MQTT_RECONNECT_TIME*2
	proc_data_state=EN_MQTT_PD_STATES_READING_HEADER
	callback_mqtt_connect_lost()
end sub

sub mqtt_drop_connection()
'Closes the socket immediately and schedules a reconnect
	dim current_sock as byte = sock.num
	mqtt_set_lost()
	sock.num=mqtt_sock_num
	sock.discard()
	sock.num=current_sock
end sub

sub mqtt_connect_socket()

	if mqtt_server_ip="" then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("No server IP address yet.")
		#endif
		mqtt_state=EN_MQTT_STATES_NOT_CONNECTED
		mqtt_connection_counter=MQTT_RECONNECT_TIME*2
		exit sub
	end if

	sock.num=mqtt_sock_num
	'A previous attempt may still be open or half-open; sock.connect() would be ignored then
	if sock.statesimple<>PL_SSTS_CLOSED then
		sock.discard()
	end if

	if mqtt_encrypted=true then
		#if TLS_AVAILABLE
			'Only one TLS session can exist. If another connection (e.g. an HTTPS request)
			'is using it right now, don't break it: try again after MQTT_RECONNECT_TIME.
			if sock.tlscurrentnum<>255 and sock.tlscurrentnum<>mqtt_sock_num then
				sock.num=sock.tlscurrentnum
				if sock.statesimple<>PL_SSTS_CLOSED then
					sock.num=mqtt_sock_num
					#if MQTT_DEBUG_PRINT
						mqtt_debugprint("TLS in use by another connection, will retry.")
					#endif
					mqtt_state=EN_MQTT_STATES_NOT_CONNECTED
					mqtt_connection_counter=MQTT_RECONNECT_TIME*2
					exit sub
				end if
				sock.tlsdeinit()
			end if
			sock.num=mqtt_sock_num
			#if PLATFORM_ID <> WM2000
				'allocate the TLS buffer once, not on every reconnect
				if mqtt_tls_buff_ready=false then
					sock.tlsbuffrq(39)
					sys.buffalloc()
					mqtt_tls_buff_ready=true
				end if
			#endif

			dim offset as dword
			offset = callback_mqtt_open_romfile()
			sock.tlsinit(offset)  'offset 0 = no certificate file
		#endif
	end if

	sock.num=mqtt_sock_num
	sock.rxclear()
	sock.txclear()
	'start the new session with a clean parser
	proc_data_state=EN_MQTT_PD_STATES_READING_HEADER
	mqtt_unreplied_ping_count=0
	sock.targetip=mqtt_server_ip
	sock.connect()
	mqtt_state=EN_MQTT_STATES_CONNECTING
	mqtt_connection_counter=MQTT_CONNECTION_TIMER*2
end sub

sub mqtt_start_dns()
	dim status as en_dns_status_codes
	mqtt_dns_waiting=false
	status=dns_connect(mqtt_target_interface,"",0)
	if status=EN_STATUS_DNS_OK then
		dns_query(mqtt_server_address)
	else if status=EN_STATUS_DNS_REQUEST_IN_PROGRESS then
		'another lookup (e.g. HTTP) is running: try again on the next timer tick
		mqtt_dns_waiting=true
	else
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("DNS not available, will retry.")
		#endif
	end if
end sub

function mqtt_connect() as ok_ng
'API function, instructs the library to connect to the MQTT server (broker).<br><br>
'<b>dst_ip</b>- the IP address of the MQTT server,<br>
'<b>dst_port</b>- target port on the MATT server,<br>
'<b>user</b> and <b>password</b>- MQTT server login credentials,<br>
'<b>url</b> is used for ssl certerficate validation<br>
'<b>client_id</b> unique client ID string for your app must be defined to use MQTT<br>
'<b>keep_alive</b>- the interval, in seconds, at which the server will ping this device.<br><br>
'Returns OK if executed successfully.
	mqtt_connect = NG
	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("ERROR: mqtt_start() wasn't called.")
		#endif
		exit function
	end if

	'already connected or logging in
	if mqtt_state=EN_MQTT_STATES_LOGGED_IN or mqtt_state=EN_MQTT_STATES_CONNECTED then
		mqtt_connect = OK
		exit function
	end if

	sock.num=mqtt_sock_num
	dim is_ip_address as boolean=true
	dim b, ascii as byte
	for b=1 to len(mqtt_server_address)
        ascii=asc(mid(mqtt_server_address,b,1))
        if ascii<46 or ascii>57 or ascii=47 then	'only digits and dots
            is_ip_address=false
            exit for
        end if
    next b

    if is_ip_address = false then
		'Look the name up on every (re)connect: an earlier lookup may have failed
		'(e.g. the network was not up yet) and the server's address may have changed.
		mqtt_state=EN_MQTT_STATES_DNS_NOT_COMPLETE
		mqtt_connection_counter=MQTT_CONNECTION_TIMER*2
		mqtt_start_dns()
	else
		mqtt_server_ip=mqtt_server_address
		mqtt_connect_socket()
	end if

	mqtt_connect = OK

end function

sub mqtt_disconnect()
'API procedure, disconnects the device from the MQTT server (broker).

	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("ERROR: mqtt_start() wasn't called.")
		#endif
		exit sub
	end if

	if mqtt_state=EN_MQTT_STATES_LOGGED_IN then
		mqtt_send_data(chr(DISCONNECT)+chr(0))
	end if
	mqtt_state=EN_MQTT_STATES_IDLE
	mqtt_user = ""
	mqtt_init_flag=0
	sock.num=mqtt_sock_num
	sock.close()
	sock_release(mqtt_sock_num)
end sub

sub mqtt_sub(byref topic as string,qos as en_qos_choices)
'API procedure, subscribes the device to the specified topic on the MQTT server (broker).<br><br>
'<b>topic</b>- the topic to subscribe to,<br>
'<b>qos</b>- requested quality of service, according to the en_qos_choices enum.

	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("ERROR: mqtt_start() wasn't called.")
		#endif
		exit sub
	end if
	if mqtt_state<>EN_MQTT_STATES_LOGGED_IN then exit sub

	#if MQTT_DEBUG_PRINT
		mqtt_debugprint("Subscribing to: data="+topic)
	#endif

	'parts are sent separately: one string holds at most 255 bytes
	mqtt_send_data(chr(SUBSCRIBE+2)+mqtt_build_remaining_length(2+2+len(topic)+1))
	mqtt_send_data(mqtt_get_packet_identifier()+chr(0)+chr(len(topic)))
	mqtt_send_data(topic)
	mqtt_send_data(chr(qos))

end sub

sub mqtt_unsub(byref topic as string)
'API procedure, unsubscribes the device from the specified topic.<br><br>
'<b>topic</b>- message to unsubscribe from.

	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("ERROR: mqtt_start() wasn't called.")
		#endif
		exit sub
	end if
	if mqtt_state<>EN_MQTT_STATES_LOGGED_IN then exit sub

	#if MQTT_DEBUG_PRINT
		mqtt_debugprint("Unsubscribing from: data="+topic)
	#endif

	mqtt_send_data(chr(UNSUBSCRIBE+2)+mqtt_build_remaining_length(2+2+len(topic)))
	mqtt_send_data(mqtt_get_packet_identifier()+chr(0)+chr(len(topic)))
	mqtt_send_data(topic)

end sub

sub mqtt_ping()

	if mqtt_ping_counter>0 then
		mqtt_ping_counter=mqtt_ping_counter-1
	end if
	'(the counter used to wrap to 65535 when a ping was skipped, stopping pings for ~9 hours)
	if mqtt_ping_counter<>0 then exit sub

	if mqtt_unreplied_ping_count>=3 then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("PING is unresponsive, disconnecting...")
		#endif
		mqtt_drop_connection()
		exit sub
	end if

	#if MQTT_DEBUG_PRINT
		mqtt_debugprint("Ping.")
	#endif
	mqtt_send_data(chr(PINGREQ)+chr(0))
	mqtt_ping_counter=MQTT_PING_TIMER*2
	mqtt_unreplied_ping_count=mqtt_unreplied_ping_count+1

end sub

sub mqtt_proc_timer()
'Event procedure, call it from the on_sys_timer() event handler.

	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then exit sub

	if mqtt_state=EN_MQTT_STATES_LOGGED_IN then
		mqtt_ping()
		exit sub
	end if
	if mqtt_state=EN_MQTT_STATES_IDLE then exit sub

	if mqtt_state=EN_MQTT_STATES_DNS_NOT_COMPLETE and mqtt_dns_waiting=true then
		mqtt_start_dns()
	end if

	if mqtt_connection_counter>0 then
		mqtt_connection_counter=mqtt_connection_counter-1
	end if
	if mqtt_connection_counter<>0 then exit sub

	select case mqtt_state
	case EN_MQTT_STATES_NOT_CONNECTED:
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("Retrying connection...")
		#endif
		mqtt_connect()	'looks the server name up again

	case EN_MQTT_STATES_DNS_NOT_COMPLETE:
		if mqtt_server_ip<>"" then
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("No DNS answer, using last known address...")
			#endif
			mqtt_connect_socket()
		else
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("No DNS answer, retrying...")
			#endif
			mqtt_connect()
		end if

	case EN_MQTT_STATES_CONNECTING:
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("Connection timed out. Reconnecting...")
		#endif
		sock.num=mqtt_sock_num
		sock.discard()
		mqtt_state=EN_MQTT_STATES_NOT_CONNECTED
		mqtt_connect()

	case EN_MQTT_STATES_CONNECTED:
		'TCP (and TLS) is up but no CONNACK: close the socket, or the next
		'sock.connect() would be ignored and the library would never reconnect
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("Unable to log in to server...")
		#endif
		mqtt_drop_connection()
	end select

end sub

sub mqtt_sock_event(newstate as enum pl_sock_state, newstatesimple as enum pl_sock_state_simple)
	if sock.num<>mqtt_sock_num then
		exit sub
	end if
	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then exit sub

	if newstatesimple=PL_SSTS_CLOSED then
		'Any way a connection ends or fails (FIN, reset, ARP or connect timeout, discard).
		'Ignore a late event for a connection that a new attempt has already replaced.
		if sock.statesimple<>PL_SSTS_CLOSED then exit sub
		#if MQTT_DEBUG_PRINT
			if mqtt_state=EN_MQTT_STATES_CONNECTING or mqtt_state=EN_MQTT_STATES_CONNECTED or mqtt_state=EN_MQTT_STATES_LOGGED_IN then
				mqtt_debugprint("Lost server connection.")
			end if
		#endif
		mqtt_set_lost()
		exit sub
	end if

	select case newstate
	case PL_SST_EST_AOPENED:
		mqtt_connection_counter=MQTT_CONNECTION_TIMER*2	'time limit for TLS handshake and login
		if mqtt_encrypted=false then
			mqtt_state=EN_MQTT_STATES_CONNECTED
			mqtt_send_login()
		else
#if TLS_AVAILABLE
			if mqtt_server_address<>mqtt_server_ip then
				sock.tlshandshake(mqtt_server_address)
			else
				sock.tlshandshake("")
			end if
#endif
		end if
	case PL_SST_EST_TLS:
		mqtt_connection_counter=MQTT_CONNECTION_TIMER*2
		mqtt_state=EN_MQTT_STATES_CONNECTED
		mqtt_send_login()
	end select

end sub

sub mqtt_publish_reply()
'Acknowledges a received PUBLISH according to its QoS
	dim buf as string
	if mqtt_proc_data_variables.qos=QOS_AT_LEAST_ONCE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("Publish ack.")
		#endif
		buf = chr(PUBACK) + chr(2) + mqtt_proc_data_variables.packet_identifier
		mqtt_send_data(buf)
	else if	mqtt_proc_data_variables.qos=QOS_EXACTLY_ONCE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("Publish rec.")
		#endif
		buf=chr(PUBREC) + chr(2) + mqtt_proc_data_variables.packet_identifier
		mqtt_send_data(buf)
	end if
end sub


sub mqtt_proc_data()
'Event procedure, call it from the on_sock_data_arrival event handler.

	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then exit sub
	if sock.num<>mqtt_sock_num then exit sub

	'Several MQTT packets can arrive in one TCP segment: handle all complete ones
	dim i as byte
	for i=1 to MQTT_MAX_PACKETS_PER_EVENT
		if mqtt_proc_packet()=false then exit for
	next i
	sock.num=mqtt_sock_num

end sub

function mqtt_proc_packet() as boolean
'Handles one MQTT packet, or one chunk of a long PUBLISH payload.
'Returns true if something was handled and more data may be waiting.
'Bytes are only taken from the RX buffer once everything needed has arrived,
'so a packet split across TCP segments is simply finished on a later call.

	dim buf as string
	dim avail as dword
	dim rl, digit, multiplier as dword
	dim n, tlen as word
	dim hdr_len, b, ptype, pid_len as byte

	mqtt_proc_packet=false
	sock.num=mqtt_sock_num
	avail=mqtt_sock_peeklen()
	if avail=0 then exit function

	'---- next chunk of a PUBLISH payload ----
	if proc_data_state=EN_MQTT_PD_STATES_READING_PAYLOAD_DATA then
		n=255
		if mqtt_proc_data_variables.remaining_length<n then n=mqtt_proc_data_variables.remaining_length
		if avail<n then n=avail
		buf=mqtt_sock_getdata(n)
		if len(buf)=0 then exit function
		mqtt_proc_data_variables.remaining_length=mqtt_proc_data_variables.remaining_length-len(buf)
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("Notification: topic="+mqtt_proc_data_variables.topic+", data="+buf)
		#endif
		callback_mqtt_notif(mqtt_proc_data_variables.topic,buf,mqtt_proc_data_variables.remaining_length)
		if mqtt_proc_data_variables.remaining_length=0 then
			mqtt_publish_reply()
			proc_data_state=EN_MQTT_PD_STATES_READING_HEADER
		end if
		mqtt_proc_packet=true
		exit function
	end if

	'---- fixed header: type byte + 1..4 remaining length bytes (peek only) ----
	n=5
	buf=mqtt_sock_peekdata(n)
	if len(buf)<2 then exit function
	rl=0
	multiplier=1
	hdr_len=1
	do
		hdr_len=hdr_len+1
		if hdr_len>len(buf) then exit function	'length bytes not all here yet
		b=asc(mid(buf,hdr_len,1))
		digit=b and 127
		rl=rl+digit*multiplier
		multiplier=multiplier*128
		if hdr_len=5 and (b and 128)<>0 then
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("Invalid packet length, reconnecting.")
			#endif
			mqtt_drop_connection()
			exit function
		end if
	loop while (b and 128)<>0

	ptype=asc(left(buf,1))
	mqtt_proc_data_variables.message_type=ptype and &hF0
	mqtt_proc_data_variables.qos=(ptype and &h06) shr 1
	mqtt_proc_data_variables.fixed_header_length=hdr_len
	mqtt_proc_data_variables.packet_identifier=""

	'---- PUBLISH: take the variable header once it has fully arrived, then stream the payload ----
	if mqtt_proc_data_variables.message_type=PUBLISH then
		pid_len=0
		if mqtt_proc_data_variables.qos<>QOS_AT_MOST_ONCE then pid_len=2

		if avail<hdr_len+2 then exit function
		n=hdr_len+2
		buf=mqtt_sock_peekdata(n)
		tlen=asc(mid(buf,hdr_len+1,1))
		tlen=tlen*256+asc(mid(buf,hdr_len+2,1))

		if rl>65535 or rl<2+tlen+pid_len then
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("PUBLISH too large or invalid, reconnecting.")
			#endif
			mqtt_drop_connection()
			exit function
		end if
		if avail<hdr_len+2+tlen+pid_len then exit function	'wait for the whole variable header

		n=hdr_len+2
		mqtt_sock_getdata(n)
		n=tlen
		if n>255 then n=255
		mqtt_proc_data_variables.topic=mqtt_sock_getdata(n)
		if tlen>len(mqtt_proc_data_variables.topic) then
			mqtt_sock_skip(tlen-len(mqtt_proc_data_variables.topic))	'topic longer than a string
		end if
		mqtt_proc_data_variables.topic_length=tlen
		if pid_len>0 then
			n=2
			mqtt_proc_data_variables.packet_identifier=mqtt_sock_getdata(n)
		end if
		mqtt_proc_data_variables.remaining_length=rl-2-tlen-pid_len

		if mqtt_proc_data_variables.remaining_length=0 then
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("Notification: topic="+mqtt_proc_data_variables.topic+", NO DATA SENT")
			#endif
			callback_mqtt_notif(mqtt_proc_data_variables.topic,"",mqtt_proc_data_variables.remaining_length)
			mqtt_publish_reply()
			proc_data_state=EN_MQTT_PD_STATES_READING_HEADER
		else
			proc_data_state=EN_MQTT_PD_STATES_READING_PAYLOAD_DATA
		end if
		mqtt_proc_packet=true
		exit function
	end if

	'---- other packets are short: wait until the whole packet is here ----
	if avail<hdr_len+rl then exit function
	n=hdr_len
	mqtt_sock_getdata(n)
	buf=""
	if rl>0 then
		n=255
		if rl<n then n=rl
		buf=mqtt_sock_getdata(n)
		if rl>len(buf) then mqtt_sock_skip(rl-len(buf))
	end if
	mqtt_proc_data_variables.packet_identifier=left(buf,2)
	proc_data_state=EN_MQTT_PD_STATES_READING_HEADER
	mqtt_proc_packet=true

	select case (mqtt_proc_data_variables.message_type)

		case CONNACK:
			'byte 2 is the return code: 0 = accepted, 1 = protocol version, 2 = client ID rejected,
			'3 = server unavailable, 4 = bad user name or password, 5 = not authorized
			if len(buf)>=2 and asc(mid(buf,2,1))=0 then
				#if MQTT_DEBUG_PRINT
					mqtt_debugprint("Connected to server.")
				#endif
				mqtt_ping_counter=MQTT_PING_TIMER*2
				mqtt_state=EN_MQTT_STATES_LOGGED_IN
				mqtt_connection_counter=MQTT_CONNECTION_TIMER*2
				mqtt_unreplied_ping_count=0
				callback_mqtt_connect_ok()
			else
				#if MQTT_DEBUG_PRINT
					if len(buf)>=2 then
						mqtt_debugprint("Server refused the connection, return code "+str(asc(mid(buf,2,1))))
					else
						mqtt_debugprint("Invalid CONNACK.")
					end if
				#endif
				mqtt_drop_connection()
				mqtt_proc_packet=false
			end if

		case PUBACK:
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("Publish ack.")
			#endif

		case PUBREC:
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("Publish rec.")
			#endif
			mqtt_send_data(chr(PUBREL+2) + chr(2) + mqtt_proc_data_variables.packet_identifier)

		case PUBREL:
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("Publish rel.")
			#endif
			mqtt_send_data(chr(PUBCOMP) + chr(2) + mqtt_proc_data_variables.packet_identifier)

		case PUBCOMP:
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("Publish comp.")
			#endif

		case SUBACK:
			'last byte is the granted QoS, &h80 means the subscription was refused
			if len(buf)>=3 and asc(right(buf,1))=&h80 then
				#if MQTT_DEBUG_PRINT
					mqtt_debugprint("Subscription refused by server.")
				#endif
			else
				#if MQTT_DEBUG_PRINT
					mqtt_debugprint("Subscribe ack.")
				#endif
				callback_mqtt_sub_ok()
			end if

		case UNSUBACK:
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("Unsubscribe ack.")
			#endif

		case PINGRESP:
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("Ping response.")
			#endif
			mqtt_unreplied_ping_count=0
	end select

end function

sub mqtt_dns_answer_acquired(return_type as en_dns_return_type, byref return_string as string)

	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then exit sub
	if mqtt_state<>EN_MQTT_STATES_DNS_NOT_COMPLETE then exit sub
	if(return_type=EN_DNS_RET_IP) then
        if dns_current_domain() = mqtt_server_address then
            mqtt_server_ip = ddstr(return_string)
			mqtt_connect_socket()
        end if
	end if

end sub

sub mqtt_send_data(data as string)
'Sends data on the MQTT socket. If the data can't be sent completely, the
'connection is dropped: a partly sent packet would corrupt the MQTT stream.

	dim current_sock as byte = sock.num
	dim tmr as dword
	dim n as word
	dim connected as boolean

	sock.num=mqtt_sock_num
	tmr=sys.timercountms

	while len(data)>0
		connected=false
		if mqtt_encrypted=true then
#if TLS_AVAILABLE
			connected=(sock.state=PL_SST_EST_TLS)
#endif
		else
			connected=(sock.statesimple=PL_SSTS_EST)
		end if

		if connected=false then
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("unable to send, disconnected")
			#endif
			mqtt_set_lost()
			exit while
		end if

		n=0
		if mqtt_encrypted=true then
#if TLS_AVAILABLE
			n=sock.tlssetdata(data)
#endif
		else
			n=sock.txfree
			if n>len(data) then n=len(data)
			if n>0 then sock.setdata(left(data,n))
		end if

		if n>0 then
			sock.send
			data=right(data,len(data)-n)	'keep the bytes not sent yet
			tmr=sys.timercountms
		else if sys.timercountms-tmr>=MQTT_TIMEOUT then
			#if MQTT_DEBUG_PRINT
				mqtt_debugprint("send timeout, disconnecting")
			#endif
			mqtt_drop_connection()
			exit while
		end if
	wend

	sock.num = current_sock

end sub

sub mqtt_publish(byref topic as string, byref data as string, qos as en_qos_choices)
'API procedure, publishes a <b>topic</b> and its <b>data</b> to the MQTT server (broker).

	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("ERROR: mqtt_start() wasn't called.")
		#endif
		exit sub
	end if
	if mqtt_state<>EN_MQTT_STATES_LOGGED_IN then exit sub

	dim size as dword

	#if MQTT_DEBUG_PRINT
		mqtt_debugprint("Publishing: topic="+topic+", data="+data)
	#endif

	size=2+len(topic)+len(data)
	if qos<>QOS_AT_MOST_ONCE then size=size+2

	'Header and parts are sent separately: one string holds at most 255 bytes,
	'and building the whole packet in one string cut long messages off.
	mqtt_send_data(chr(PUBLISH+MQTT_RETAIN_BIT+(qos*2))+mqtt_build_remaining_length(size)+chr(0)+chr(len(topic)))
	mqtt_send_data(topic)
	if qos<>QOS_AT_MOST_ONCE then
		mqtt_send_data(mqtt_get_packet_identifier())
	end if
	mqtt_send_data(data)
	mqtt_ping_counter=MQTT_PING_TIMER*2

end sub

#if MQTT_LARGE_PACKETS

sub mqtt_start_publish(byref topic as string, qos as en_qos_choices, length as dword)
'API procedure, starts the procedure of publishing to the MQTT server (broker). Must be called before calling mqtt_continue_publish().
'<b>topic</b> - Name of the topic to be published
'<b>qos</b> - QoS level
'<b>length</b> - Total length of the payload to be sent


	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("ERROR: mqtt_start() wasn't called.")
		#endif
		exit sub
	end if
	if mqtt_state<>EN_MQTT_STATES_LOGGED_IN then exit sub

	if mqtt_packet_length<>0 then
		#if MQTT_DEBUG_PRINT
		mqtt_debugprint("ERROR: Previous MQTT packet not fully sent. " + str(mqtt_packet_length) + " bytes remaining.")
		#endif
		mqtt_packet_length=0
		exit sub
	end if
	mqtt_packet_length=length
	dim size as dword
	#if MQTT_DEBUG_PRINT
		mqtt_debugprint("Publishing: topic="+topic)
	#endif
	size=2+len(topic)+length
	if qos<>QOS_AT_MOST_ONCE then size=size+2
	mqtt_send_data(chr(PUBLISH+MQTT_RETAIN_BIT+(qos*2))+mqtt_build_remaining_length(size)+chr(0)+chr(len(topic)))
	mqtt_send_data(topic)
	if qos<>QOS_AT_MOST_ONCE then
		mqtt_send_data(mqtt_get_packet_identifier())
	end if

end sub

sub mqtt_continue_publish(byref data as string)
'API procedure, continues publishing to the MQTT server (broker). Must be called until the number of bytes set in mqtt_start_publish() has been reached.
'<b>data</b> - Data to be sent. Cannot exceed 255 bytes. To send a payload greater than 255 bytes, the subroutine must be called again.

	if mqtt_init_flag<>MQTT_INIT_SIGNATURE then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("ERROR: mqtt_start() wasn't called.")
		#endif
		exit sub
	end if
	if mqtt_state<>EN_MQTT_STATES_LOGGED_IN then
		mqtt_packet_length=0
		exit sub
	end if

	mqtt_packet_length=mqtt_packet_length-len(data)
	if mqtt_packet_length < 0 then
		#if MQTT_DEBUG_PRINT
			mqtt_debugprint("ERROR: Number of bytes being sent exceeds number set in header")
		#endif
		mqtt_packet_length=0
		exit sub
	end if
	mqtt_send_data(data)
	mqtt_ping_counter=MQTT_PING_TIMER*2

end sub

#endif

#if MQTT_DEBUG_PRINT
sub mqtt_debugprint(data as string)
	dim s as string

	s = MQTT_STAMP+data+MQTT_CR_LF
	callback_mqtt_debugprint(s)
	#if MQTT_DEBUG_PRINT = 2
		sys.debugprint(s)
	#endif
end sub
#endif
